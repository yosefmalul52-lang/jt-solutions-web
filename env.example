# Admin gate
ADMIN_PASSWORD=change-me-strong-password

# Contact notifications
SMTP_USER=
SMTP_PASS=

# Supabase — REQUIRED for admin dashboard reads/writes:
# Project Settings → API → service_role (secret, server-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Fallback only for contact form RPC (submit_site_lead). Do NOT put this in NEXT_PUBLIC_*.
SUPABASE_ANON_KEY=

# Rate limiting on Vercel: use Firewall (no Redis/Upstash).
# Live rule on this project: "Rate limit login+contact"
#   POST /api/admin/login OR POST /api/contact → 20 req / 10 min / IP
# Manage: vercel firewall rules list | Vercel Dashboard → Firewall

# Optional booking CTA in admin
NEXT_PUBLIC_BOOKING_URL=
